{
  "version": "1.0",
  "last_updated": "2025-02-04",
  "repository": "awsome2",
  "containers": [
    {
      "name": "analyzer",
      "description": "AI agent that analyzes security findings from AWS Security Hub",
      "ecr_pattern": "shara-analyzer",
      "path": "agent/agents/analyzer",
      "dockerfile": "agent/agents/analyzer/Dockerfile",
      "base_image": "python:3.12-slim",
      "language": "python",
      "framework": "fastapi",
      "port": 8080,
      "dependencies": [
        {
          "file": "agent/agents/analyzer/requirements.txt",
          "type": "pip"
        }
      ]
    },
    {
      "name": "remediator",
      "description": "AI agent that executes remediation actions for vulnerabilities",
      "ecr_pattern": "shara-remediator",
      "path": "agent/agents/remediator",
      "dockerfile": "agent/agents/remediator/Dockerfile",
      "base_image": "python:3.12-slim",
      "language": "python",
      "framework": "fastapi",
      "port": 8081,
      "dependencies": [
        {
          "file": "agent/agents/remediator/requirements.txt",
          "type": "pip"
        }
      ]
    },
    {
      "name": "validator",
      "description": "AI agent that validates remediation results",
      "ecr_pattern": "shara-validator",
      "path": "agent/agents/validator",
      "dockerfile": "agent/agents/validator/Dockerfile",
      "base_image": "python:3.12-slim",
      "language": "python",
      "framework": "fastapi",
      "port": 8082,
      "dependencies": [
        {
          "file": "agent/agents/validator/requirements.txt",
          "type": "pip"
        }
      ]
    },
    {
      "name": "user-service",
      "description": "User management and authentication microservice",
      "ecr_pattern": "user-service",
      "path": "application/services/user-service",
      "dockerfile": "application/services/user-service/Dockerfile",
      "base_image": "public.ecr.aws/docker/library/amazoncorretto:21-alpine",
      "language": "java",
      "framework": "spring-boot",
      "port": 8080,
      "dependencies": [
        {
          "file": "application/services/user-service/pom.xml",
          "type": "maven"
        }
      ]
    },
    {
      "name": "profile-service",
      "description": "User profile management microservice",
      "ecr_pattern": "profile-service",
      "path": "application/services/profile-service",
      "dockerfile": "application/services/profile-service/Dockerfile",
      "base_image": "public.ecr.aws/docker/library/amazoncorretto:21-alpine",
      "language": "java",
      "framework": "spring-boot",
      "port": 8080,
      "dependencies": [
        {
          "file": "application/services/profile-service/pom.xml",
          "type": "maven"
        }
      ]
    },
    {
      "name": "notification-service",
      "description": "Email notification microservice via AWS SES",
      "ecr_pattern": "notification-service",
      "path": "application/services/notification-service",
      "dockerfile": "application/services/notification-service/Dockerfile",
      "base_image": "public.ecr.aws/docker/library/amazoncorretto:21-alpine",
      "language": "java",
      "framework": "spring-boot",
      "port": 8080,
      "dependencies": [
        {
          "file": "application/services/notification-service/pom.xml",
          "type": "maven"
        }
      ]
    },
    {
      "name": "frontend",
      "description": "React frontend application deployed via CloudFront",
      "ecr_pattern": null,
      "path": "application/services/frontend",
      "dockerfile": null,
      "base_image": null,
      "language": "typescript",
      "framework": "react",
      "port": null,
      "deployment": "cloudfront",
      "dependencies": [
        {
          "file": "application/services/frontend/package.json",
          "type": "npm"
        }
      ]
    }
  ],
  "remediation_patterns": {
    "pip": {
      "file_pattern": "requirements.txt",
      "update_format": "{package}=={version}",
      "comment_prefix": "#"
    },
    "maven": {
      "file_pattern": "pom.xml",
      "update_format": "<version>{version}</version>",
      "version_xpath": "//dependency[groupId='{groupId}' and artifactId='{artifactId}']/version"
    },
    "npm": {
      "file_pattern": "package.json",
      "update_format": "\"{package}\": \"{version}\"",
      "sections": ["dependencies", "devDependencies"]
    },
    "dockerfile": {
      "base_image_pattern": "FROM {image}:{tag}",
      "arg_pattern": "ARG {name}={value}"
    }
  }
}
