# ===== Terraform =====
# State files - contain sensitive data, should never be committed
*.tfstate
*.tfstate.*
errored.tfstate

# Crash log files
crash.log
crash.*.log

# Terraform directories
.terraform/
.terraform.lock.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfvars files - may contain sensitive variables
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform plan output
*.tfplan
tfplan

