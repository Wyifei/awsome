# SHARA Agents - Environment Variables
# 复制此文件为 .env 并填入实际值

# AWS Configuration
AWS_REGION=ap-northeast-1

# DynamoDB Tables (Terraform 部署后自动创建)
TASKS_TABLE=shara-dev-tasks
TOKENS_TABLE=shara-dev-approval-tokens

# S3 Buckets
ASR_PLAYBOOKS_BUCKET=shara-dev-asr-playbooks-870414140965
# 审计日志 bucket - 存储 Remediator 执行的代码和日志
REMEDIATION_AUDIT_BUCKET=shara-dev-remediation-audit-870414140965

# AgentCore Memory ID (从 scripts/create_shara_memory.py 创建)
AGENTCORE_MEMORY_ID=shara_remediation_memory-BX1dmV3p5h

# AgentCore Code Interpreter (通过 Console 创建，关联 IAM Role)
# 用于 Remediator 在安全沙箱中执行修复代码
CODE_INTERPRETER_ID=shara_interpreter_tool-sGd1u5rIet

# LLM Model
MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
